{
  "name": "streamscope",
  "version": "0.1.0",
  "description": "Chrome DevTools panel that reassembles LLM streaming (SSE) responses: final text, tool-call JSON, latency metrics, replayable export.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "npm run build && node scripts/mock-server.mjs",
    "mock": "node scripts/mock-server.mjs",
    "build": "vite build && vite build --config vite.inject.config.ts --mode main && vite build --config vite.inject.config.ts --mode relay",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "test:e2e": "node e2e/extension.e2e.mjs"
  },
  "dependencies": {
    "eventsource-parser": "4.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
