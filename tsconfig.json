{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["chrome", "node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "tests", "vite.config.ts", "vite.inject.config.ts", "vitest.config.ts"]
}
